{
  "schemaVersion": 1,
  "id": "camerapathaddon",
  "version": "1.0.0",
  "name": "Camera Path Addon",
  "description": "Keyframed camera paths for tudursvehiclemod: move the player's view or an unmanned vehicle precisely along a timed path.",
  "authors": [ "Tuduraw" ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [ "com.example.camerapathaddon.CameraPathAddon" ],
    "client": [ "com.example.camerapathaddon.client.CameraPathAddonClient" ]
  },
  "mixins": [
    {
      "config": "camerapathaddon.mixins.json",
      "environment": "*"
    },
    {
      "config": "camerapathaddon.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21",
    "tudursvehiclemod": ">=1.1.0"
  }
}
